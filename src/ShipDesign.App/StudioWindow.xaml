<Window x:Class="ShipDesign.App.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="ShipDesign — Rendu studio" Height="800" Width="1200"
        Background="#05101A"
        FontFamily="{StaticResource MonoFont}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource LineCyanDimBrush}" BorderThickness="0,0,0,1"
                Padding="18,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="RENDU STUDIO" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                           Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Designation}" Margin="16,0,0,0" FontSize="11"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" Margin="28,0,0,0">
                    <CheckBox x:Name="GlowToggle" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Halo" FontSize="10.5" Margin="8,0,0,0"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <CheckBox x:Name="SpinToggle" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Rotation" FontSize="10.5" Margin="8,0,0,0"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Studio backdrop: a soft pool of light behind the ship rather than a flat fill, so the
             silhouette has something to separate from at its edges. -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.42,0.36" Center="0.42,0.36" RadiusX="0.85" RadiusY="0.85">
                    <GradientStop Color="#16303F" Offset="0" />
                    <GradientStop Color="#0A1A26" Offset="0.55" />
                    <GradientStop Color="#040C14" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <h:HelixViewport3D x:Name="MainViewport" Background="Transparent"
                               ShowCoordinateSystem="False" ShowViewCube="False"
                               IsHeadLightEnabled="False" />

            <!-- Glow pass. A second viewport holding only the emissive faces, blurred and laid over
                 the first. WPF has no post-processing and no additive blending, but a blurred copy
                 of just the lights, composited over the lit scene, reads convincingly as bloom,
                 and it is the one way to get the effect here without changing renderer. -->
            <h:HelixViewport3D x:Name="GlowViewport" Background="Transparent"
                               ShowCoordinateSystem="False" ShowViewCube="False"
                               IsHeadLightEnabled="False" IsHitTestVisible="False"
                               InfiniteSpin="False">
                <h:HelixViewport3D.Effect>
                    <BlurEffect Radius="26" KernelType="Gaussian" />
                </h:HelixViewport3D.Effect>
            </h:HelixViewport3D>

            <!-- A second, tighter blur pass concentrates the core of the halo. -->
            <h:HelixViewport3D x:Name="GlowCoreViewport" Background="Transparent"
                               ShowCoordinateSystem="False" ShowViewCube="False"
                               IsHeadLightEnabled="False" IsHitTestVisible="False">
                <h:HelixViewport3D.Effect>
                    <BlurEffect Radius="8" KernelType="Gaussian" />
                </h:HelixViewport3D.Effect>
            </h:HelixViewport3D>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource LineCyanDimBrush}" BorderThickness="0,1,0,0"
                Padding="18,8">
            <TextBlock x:Name="StatusLine" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" />
        </Border>
    </Grid>
</Window>
