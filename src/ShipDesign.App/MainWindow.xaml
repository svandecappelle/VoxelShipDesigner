<Window x:Class="ShipDesign.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:local="clr-namespace:ShipDesign.App"
        mc:Ignorable="d"
        Title="ShipDesign" Height="760" Width="1140"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="{StaticResource MonoFont}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Topbar ============ -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource LineCyanDimBrush}" BorderThickness="0,0,0,1"
                Padding="20,0" Height="58">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="30" Height="30" Margin="0,0,12,0">
                        <Ellipse Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" Opacity="0.5"
                                 StrokeDashArray="2 3" />
                        <Polygon Points="15,4 20,20 15,17 10,20" Fill="{StaticResource AccentAmberBrush}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SHIPDESIGN" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                   FontSize="19" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="CONCEPTEUR PARAMÉTRIQUE DE COQUES — EXPORT UNITY"
                                   FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                   Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Busy indicator. Generation runs on a worker thread now, so a heavy ship takes
                         seconds while the window stays live; without something moving, "still working"
                         and "hung" look exactly the same. -->
                    <Border x:Name="BusyIndicator" Margin="0,0,14,0" Padding="11,6" CornerRadius="2"
                            Background="{StaticResource BgDeepBrush}"
                            BorderBrush="{StaticResource LineCyanBrush}" BorderThickness="1"
                            Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource LineCyanBrush}" VerticalAlignment="Center">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.15" Duration="0:0:0.6"
                                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="GÉNÉRATION" FontSize="9.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource LineCyanBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource AccentAmberDimBrush}"
                            BorderBrush="{StaticResource AccentAmberBrush}" BorderThickness="1" CornerRadius="2"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DÉSIGNATION" FontSize="9.5" Foreground="{StaticResource TextDimBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Designation}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Main content ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- === Sidebar === -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource LineCyanDimBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <!-- Silhouettes : chacune pose d'un coup la vingtaine de réglages qui font
                             un type de vaisseau reconnaissable, sans toucher à la graine ni à la
                             livrée, qui appartiennent à l'utilisateur. -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="SILHOUETTES" IsExpanded="True">
                            <ItemsControl ItemsSource="{Binding Silhouettes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Name}" ToolTip="{Binding Summary}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,6" Margin="0,0,0,4"
                                                Command="{Binding DataContext.ApplySilhouetteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- Classe de coque -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="CLASSE DE COQUE" IsExpanded="True">
                            <StackPanel>
                                <ListBox Style="{StaticResource SegmentedListBoxStyle}" ItemsSource="{Binding HullClasses}" SelectedItem="{Binding HullClass}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabelConverter}}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                        <!-- Géométrie de coque -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="GÉOMÉTRIE DE COQUE" IsExpanded="True">
                            <StackPanel>

                                <TextBlock Text="Forme de coque" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ListBox Style="{StaticResource SegmentedListBoxStyle}" ItemsSource="{Binding HullShapes}"
                                         SelectedItem="{Binding HullShape}" Margin="0,0,0,10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <!-- Stretch="None" keeps each outline at its authored size, so the
                                                     buttons show the shapes' relative proportions rather than
                                                     normalising every one of them to fill the same box. -->
                                                <Path Data="{Binding Converter={StaticResource HullShapeIconConverter}}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                      Stretch="None" Width="44" Height="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Converter={StaticResource EnumLabelConverter}}"
                                                           HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="9.5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Disposition des coques" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ListBox Style="{StaticResource SegmentedListBoxStyle}" ItemsSource="{Binding HullArrangements}"
                                         SelectedItem="{Binding HullArrangement}" Margin="0,0,0,10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Schematics are side views here, unlike the hull-shape ones:
                                                 from above the two arrangements look identical, and the
                                                 whole distinction lives in profile. -->
                                            <StackPanel>
                                                <Path Data="{Binding Converter={StaticResource HullArrangementIconConverter}}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                      Stretch="None" Width="44" Height="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Converter={StaticResource EnumLabelConverter}}" TextWrapping="Wrap"
                                                           TextAlignment="Center" Margin="0,3,0,0" FontSize="9.5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Side-by-side hulls only: a composite ship has exactly two, stacked. -->
                                <StackPanel Visibility="{Binding IsParallel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Nombre de coques" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding HullCount}" />
                                    </Grid>
                                    <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="1" Maximum="3" Value="{Binding HullCount}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Écartement des coques" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding HullSpacing, StringFormat='{}{0:0.0}×'}" />
                                    </Grid>
                                    <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.1" Maximum="6" Value="{Binding HullSpacing}" Margin="0,0,0,10" />
                                </StackPanel>

                                <!-- Stacked hulls only. -->
                                <StackPanel Visibility="{Binding IsComposite, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Part de la coque avant" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding PrimaryHullFraction, StringFormat='{}{0:P0}'}" />
                                    </Grid>
                                    <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.2" Maximum="0.8" Value="{Binding PrimaryHullFraction}" Margin="0,0,0,10"
                                            ToolTip="Longueur de la soucoupe rapportée au vaisseau entier. Autour de 45% donne la proportion Starfleet." />

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Longueur du col" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding SecondaryHullDrop, StringFormat='{}{0:0.0}×'}" />
                                    </Grid>
                                    <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.2" Maximum="4" Value="{Binding SecondaryHullDrop}" Margin="0,0,0,10"
                                            ToolTip="À quelle distance la coque d'ingénierie est suspendue sous la soucoupe." />

                                    <CheckBox Content="Déflecteur" IsChecked="{Binding Deflector}" Margin="0,0,0,10"
                                              ToolTip="Le grand disque émissif encastré dans la proue de la coque d'ingénierie." />
                                </StackPanel>

                                <!-- A catamaran is two copies of the main hull, so it has no second
                                     shape to pick; a trimaran and a composite ship both do. -->
                                <StackPanel Visibility="{Binding HasSecondaryHulls, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Longueur coque secondaire" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding SecondaryHullLength, StringFormat='{}{0:P0}'}" />
                                    </Grid>
                                    <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.25" Maximum="1" Value="{Binding SecondaryHullLength}" Margin="0,0,0,10"
                                            ToolTip="Part de sa portée que la coque secondaire occupe. Sous 100% on obtient un flotteur court à côté d'une longue coque, ou une coque d'ingénierie qui s'arrête avant la poupe." />

                                    <TextBlock Text="Forme de la coque secondaire" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                    <ListBox Style="{StaticResource SegmentedListBoxStyle}" ItemsSource="{Binding HullShapes}"
                                             SelectedItem="{Binding SecondaryHullShape}" Margin="0,0,0,10">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Path Data="{Binding Converter={StaticResource HullShapeIconConverter}}"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                          Stretch="None" Width="44" Height="22" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabelConverter}}"
                                                               HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="9.5" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Longueur" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding Length, StringFormat='{}{0:0.0} M'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="4" Maximum="90" Value="{Binding Length}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Maître-bau (largeur)" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding Beam, StringFormat='{}{0:0.0} M'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.6" Maximum="18" Value="{Binding Beam}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Effilement du nez" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding Taper, StringFormat='{}{0:P0}'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0" Maximum="1" Value="{Binding Taper}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Creux (hauteur)" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding Depth, StringFormat='{}{0:0.0} M'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.3" Maximum="12" Value="{Binding Depth}" Margin="0,0,0,10"
                                        ToolTip="Hauteur de coque, indépendante du maître-bau. La classe module encore la section : un cargo reste plus cubique qu'un croiseur à creux égal." />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Quille plate" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding KeelFlatness, StringFormat='{}{0:P0}'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0" Maximum="1" Value="{Binding KeelFlatness}" Margin="0,0,0,10"
                                        ToolTip="Déplace la profondeur de coque au-dessus de l'axe et supprime le chanfrein inférieur. À 100% le dessous est un plan unique : la section en lame des destroyers impériaux." />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Lignes de pont" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding Decks}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="1" Maximum="12" Value="{Binding Decks}" TickFrequency="1" IsSnapToTickEnabled="True" />
                            </StackPanel>
                        </Expander>

                        <!-- Ailes -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="AILES" IsExpanded="False">
                            <StackPanel>
                                <ListBox Style="{StaticResource SegmentedListBoxStyle}" ItemsSource="{Binding WingStyles}" SelectedItem="{Binding WingStyle}" Margin="0,0,0,6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabelConverter}}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Envergure" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding WingSpan, StringFormat='{}{0:0.0} M'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.5" Maximum="36" Value="{Binding WingSpan}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Angle de flèche" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding WingSweepDegrees, StringFormat='{}{0:0}°'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="-30" Maximum="85" Value="{Binding WingSweepDegrees}" />
                            </StackPanel>
                        </Expander>

                        <!-- Propulsion -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="PROPULSION" IsExpanded="False">
                            <StackPanel>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Nombre de tuyères" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding EngineCount}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="1" Maximum="10" Value="{Binding EngineCount}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" />

                                <ListBox Style="{StaticResource SegmentedListBoxStyle}" ItemsSource="{Binding EngineStyles}" SelectedItem="{Binding EngineStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabelConverter}}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                        <!-- Cockpit -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="COCKPIT" IsExpanded="False">
                            <StackPanel>
                                <ListBox Style="{StaticResource SegmentedListBoxStyle}" ItemsSource="{Binding CockpitStyles}" SelectedItem="{Binding CockpitStyle}" Margin="0,0,0,6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabelConverter}}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Taille" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding CockpitSize, StringFormat='{}{0:0.0}×'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.15" Maximum="4" Value="{Binding CockpitSize}" />
                            </StackPanel>
                        </Expander>

                        <!-- Structures secondaires -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="STRUCTURES SECONDAIRES" IsExpanded="False">
                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Superstructure}" Margin="0,0,8,0" />
                                    <TextBlock Text="Tourelle de commandement" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Position de la tourelle" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding TowerPosition, StringFormat='{}{0:P0}'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.08" Maximum="0.95" Value="{Binding TowerPosition}" Margin="0,0,0,10"
                                        ToolTip="0% à la proue, 100% à la poupe. Tout à l'arrière donne la passerelle des destroyers impériaux." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding TowerDomes}" Margin="0,0,8,0" />
                                    <TextBlock Text="Dômes senseurs" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DorsalSpine}" Margin="0,0,8,0" />
                                    <TextBlock Text="Arête dorsale" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Hauteur de l'arête" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding SpineHeight, StringFormat='{}{0:0.0}×'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.1" Maximum="4" Value="{Binding SpineHeight}" Margin="0,0,0,10"
                                        ToolTip="Crête étagée sur l'axe, montant vers la poupe." />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Taille tourelle" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding SuperstructureSize, StringFormat='{}{0:0.0}×'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.15" Maximum="5" Value="{Binding SuperstructureSize}" Margin="0,0,0,12" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Nacelles}" Margin="0,0,8,0" />
                                    <TextBlock Text="Nacelles sur pylônes" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Ancrage" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ListBox Style="{StaticResource SegmentedListBoxStyle}" ItemsSource="{Binding NacelleMounts}"
                                         SelectedItem="{Binding NacelleMount}" Margin="0,0,0,10"
                                         ToolTip="Sur quelle coque partent les pylônes. Sur un vaisseau à soucoupe, « coque arrière » est la disposition Starfleet.">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabelConverter}}" TextWrapping="Wrap"
                                                       TextAlignment="Center" FontSize="9.5" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Éclairage" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ListBox Style="{StaticResource SegmentedListBoxStyle}" ItemsSource="{Binding NacelleStyles}"
                                         SelectedItem="{Binding NacelleStyle}" Margin="0,0,0,12"
                                         ToolTip="« Warp » remplace la tuyère arrière par un collecteur lumineux à l'avant et une grille éclairée sur les flancs.">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabelConverter}}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Largeur nacelles" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding NacelleWidth, StringFormat='{}{0:0.0}×'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.1" Maximum="4" Value="{Binding NacelleWidth}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Longueur nacelles" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding NacelleLength, StringFormat='{}{0:0.0}×'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.1" Maximum="4" Value="{Binding NacelleLength}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Espacement nacelles" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding NacelleSpacing, StringFormat='{}{0:0.0}×'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.05" Maximum="6" Value="{Binding NacelleSpacing}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Hauteur nacelles" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding NacelleRise, StringFormat='{}{0:+0.0;-0.0;0.0}'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="-4" Maximum="4" Value="{Binding NacelleRise}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Recul nacelles" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding NacelleSweep, StringFormat='{}{0:0%}'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0" Maximum="0.95" Value="{Binding NacelleSweep}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Corde des pylônes" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding PylonChord, StringFormat='{}{0:0.0}×'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0.2" Maximum="6" Value="{Binding PylonChord}"
                                        ToolTip="Profondeur du pylône d'avant en arrière : au-delà de 2 il devient une lame large plutôt qu'une entretoise." />
                            </StackPanel>
                        </Expander>

                        <!-- Détails de surface -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="DÉTAILS DE SURFACE" IsExpanded="False">
                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Greebles}" Margin="0,0,8,0" />
                                    <TextBlock Text="Panneaux &amp; greebles" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Densité" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding GreebleDensity, StringFormat='{}{0:P0}'}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0" Maximum="1" Value="{Binding GreebleDensity}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Tourelles" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" Text="{Binding TurretCount}" />
                                </Grid>
                                <Slider Style="{StaticResource ThemedSliderStyle}" Minimum="0" Maximum="24" Value="{Binding TurretCount}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" />

                                <TextBlock Text="Graine (seed)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource ThemedTextBoxStyle}" Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="OK" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplySeedCommand}" Margin="4,0,0,0" />
                                    <Button Grid.Column="2" Content="↻" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RerollSeedCommand}" Margin="4,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Livrée -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="LIVRÉE" IsExpanded="False">
                            <StackPanel>

                                <TextBlock Text="Coque" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButtonStyle}"
                                                    Command="{Binding DataContext.SetHullColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Accent / plaques" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButtonStyle}"
                                                    Command="{Binding DataContext.SetAccentColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Lueur réacteurs" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButtonStyle}"
                                                    Command="{Binding DataContext.SetEngineGlowColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Teinte verrière" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding PresetColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButtonStyle}"
                                                    Command="{Binding DataContext.SetCockpitTintColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Rendering and exporting act on the finished ship rather than describing
                             it, so they live over the viewport with the other view controls. What
                             stays here is the one action that changes the parameters themselves. -->
                        <Button Content="⚄ VAISSEAU ALÉATOIRE" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RandomizeShipCommand}" Margin="0,4,0,4" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- === Viewport === -->
            <Grid Grid.Column="1">
                <Border>
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4" RadiusX="0.75" RadiusY="0.75">
                            <GradientStop Color="#0E2C44" Offset="0" />
                            <GradientStop Color="#081826" Offset="0.7" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <h:HelixViewport3D x:Name="Viewport" Background="Transparent" ShowCoordinateSystem="False">
                    <h:HelixViewport3D.DefaultCamera>
                        <PerspectiveCamera Position="18,12,22" LookDirection="-18,-12,-22" UpDirection="0,1,0" />
                    </h:HelixViewport3D.DefaultCamera>
                    <h:SunLight />
                    <h:GridLinesVisual3D Width="20" Length="20" MinorDistance="2" MajorDistance="2"
                                          Thickness="0.02" Fill="#2A5570" />
                    <ModelVisual3D Content="{Binding ShipModel}" />
                </h:HelixViewport3D>

                <!-- Actions on the finished ship, bottom-right of the viewport: the render and the
                     export both operate on what is on screen, so they sit with it rather than at
                     the end of a long parameter list. -->
                <!-- Raised clear of the bottom edge so it sits above the viewport's navigation cube
                     rather than on top of it. -->
                <Border Style="{StaticResource HudPanelStyle}" Padding="10,9"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,96">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="◉ RENDU STUDIO" Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnOpenStudio" Padding="12,8"
                                ToolTip="Ouvre une vue séparée avec occlusion ambiante et halo composité" />
                        <Button Content="EXPORTER .GLB" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ExportCommand}" FontSize="11.5" Padding="14,8" Margin="8,0,0,0"
                                ToolTip="Le fichier .glb s'importe directement dans Unity : glissez-le dans votre dossier Assets" />
                    </StackPanel>
                </Border>

                <!-- HUD: stats, bottom-left -->
                <Border Style="{StaticResource HudPanelStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="16" IsHitTestVisible="False">
                    <StackPanel MinWidth="170">
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="LONGUEUR" Style="{StaticResource HudLabelStyle}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Length, StringFormat='{}{0:0.0} M'}" Style="{StaticResource HudValueStyle}" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="MAÎTRE-BAU" Style="{StaticResource HudLabelStyle}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Beam, StringFormat='{}{0:0.0} M'}" Style="{StaticResource HudValueStyle}" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="CLASSE DE MASSE" Style="{StaticResource HudLabelStyle}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding MassClass}" Style="{StaticResource HudValueStyle}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource LineCyanDimBrush}" Margin="0,5" />
                        <Grid>
                            <TextBlock Text="TRIANGLES" Style="{StaticResource HudLabelStyle}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TriangleCount}" Style="{StaticResource HudValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- HUD: auto-rotate + reticle, top-right -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
                    <Border Style="{StaticResource HudPanelStyle}" Padding="10,7" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ORBITE AUTO" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <CheckBox x:Name="AutoRotateToggle" Style="{StaticResource ToggleSwitchStyle}" />
                        </StackPanel>
                    </Border>

                    <Grid Width="64" Height="64" Opacity="0.4" HorizontalAlignment="Right" IsHitTestVisible="False"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="ReticleRotation" Angle="0" />
                        </Grid.RenderTransform>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ReticleRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:50"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <Ellipse Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" StrokeDashArray="1 5" />
                        <Ellipse Width="46" Height="46" Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" />
                        <Line X1="32" Y1="0" X2="32" Y2="9" Stroke="{StaticResource AccentAmberBrush}" StrokeThickness="1.5" />
                        <Line X1="32" Y1="55" X2="32" Y2="64" Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" />
                        <Line X1="0" Y1="32" X2="9" Y2="32" Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" />
                        <Line X1="55" Y1="32" X2="64" Y2="32" Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource LineCyanDimBrush}" BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock Text="{Binding StatusText}" FontSize="10.5" TextWrapping="Wrap"
                       Foreground="{StaticResource TextDimBrush}" />
        </Border>
    </Grid>
</Window>
