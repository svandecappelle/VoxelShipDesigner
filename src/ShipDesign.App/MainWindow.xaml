<Window x:Class="ShipDesign.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:local="clr-namespace:ShipDesign.App"
        mc:Ignorable="d"
        Title="ShipDesign" Height="760" Width="1140"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="{StaticResource MonoFont}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Topbar ============ -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource LineCyanDimBrush}" BorderThickness="0,0,0,1"
                Padding="20,0" Height="58">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="30" Height="30" Margin="0,0,12,0">
                        <Ellipse Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" Opacity="0.5"
                                 StrokeDashArray="2 3" />
                        <Polygon Points="15,4 20,20 15,17 10,20" Fill="{StaticResource AccentAmberBrush}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SHIPDESIGN" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                   FontSize="19" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="CONCEPTEUR PARAMÉTRIQUE DE COQUES — EXPORT UNITY"
                                   FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                   Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Busy indicator. Generation runs on a worker thread now, so a heavy ship takes
                         seconds while the window stays live; without something moving, "still working"
                         and "hung" look exactly the same. -->
                    <Border x:Name="BusyIndicator" Margin="0,0,14,0" Padding="11,6" CornerRadius="2"
                            Background="{StaticResource BgDeepBrush}"
                            BorderBrush="{StaticResource LineCyanBrush}" BorderThickness="1"
                            Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource LineCyanBrush}" VerticalAlignment="Center">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.15" Duration="0:0:0.6"
                                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="GÉNÉRATION" FontSize="9.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource LineCyanBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource AccentAmberDimBrush}"
                            BorderBrush="{StaticResource AccentAmberBrush}" BorderThickness="1" CornerRadius="2"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DÉSIGNATION" FontSize="9.5" Foreground="{StaticResource TextDimBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Designation}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Main content ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- === Sidebar === -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource LineCyanDimBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <!-- Silhouettes : chacune pose d'un coup la vingtaine de réglages qui font
                             un type de vaisseau reconnaissable, sans toucher à la graine ni à la
                             livrée, qui appartiennent à l'utilisateur. -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="SILHOUETTES" IsExpanded="True">
                            <ItemsControl ItemsSource="{Binding SilhouetteGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Style="{StaticResource SilhouetteGroupStyle}"
                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <ItemsControl ItemsSource="{Binding Silhouettes}" Margin="0,0,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{Binding Name}" ToolTip="{Binding Summary}"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                Padding="10,6" Margin="0,0,0,4"
                                                                Command="{Binding DataContext.ApplySilhouetteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- Classe de coque -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="CLASSE DE COQUE" IsExpanded="True">
                            <StackPanel>
                                <ListBox Style="{StaticResource SegmentedListBoxStyle}" ItemsSource="{Binding HullClasses}" SelectedItem="{Binding HullClass}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabelConverter}}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                        <!-- Everything with a place on the ship now lives on the ship, as an
                             anchored panel over the viewport. What is left here is what has no part
                             to point at: whole-ship presets, the class, the livery and the seed. -->

                        <!-- Graine -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="GRAINE" IsExpanded="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ThemedTextBoxStyle}" Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="OK" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplySeedCommand}" Margin="4,0,0,0" />
                                <Button Grid.Column="2" Content="↻" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RerollSeedCommand}" Margin="4,0,0,0" />
                            </Grid>
                        </Expander>

                        <!-- Livrée -->
                        <Expander Style="{StaticResource AccordionStyle}" Header="LIVRÉE" IsExpanded="False">
                            <StackPanel>

                                <TextBlock Text="Coque" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButtonStyle}"
                                                    Command="{Binding DataContext.SetHullColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Accent / plaques" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButtonStyle}"
                                                    Command="{Binding DataContext.SetAccentColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Lueur réacteurs" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButtonStyle}"
                                                    Command="{Binding DataContext.SetEngineGlowColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Teinte verrière" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding PresetColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButtonStyle}"
                                                    Command="{Binding DataContext.SetCockpitTintColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Rendering and exporting act on the finished ship rather than describing
                             it, so they live over the viewport with the other view controls. What
                             stays here is the one action that changes the parameters themselves. -->
                        <Button Content="⚄ VAISSEAU ALÉATOIRE" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RandomizeShipCommand}" Margin="0,4,0,4" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- === Viewport === -->
            <Grid Grid.Column="1">
                <Border>
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4" RadiusX="0.75" RadiusY="0.75">
                            <GradientStop Color="#0E2C44" Offset="0" />
                            <GradientStop Color="#081826" Offset="0.7" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ZoomAroundMouseDownPoint is off by default, which means the wheel pulls toward the
                     middle of the view: to look at a nacelle you zoom, then pan, then zoom again.
                     Zooming toward the pointer is what makes a model viewer navigable, and it is
                     the one default here that is plainly wrong for this application.

                     Rotation is deliberately left on the camera target rather than the pointer.
                     This is a turntable for looking at a whole ship, and a fixed pivot is what keeps
                     the ship centred while it turns. -->
                <h:HelixViewport3D x:Name="Viewport" Background="Transparent" ShowCoordinateSystem="False"
                                   ZoomAroundMouseDownPoint="True">
                    <h:HelixViewport3D.DefaultCamera>
                        <PerspectiveCamera Position="18,12,22" LookDirection="-18,-12,-22" UpDirection="0,1,0" />
                    </h:HelixViewport3D.DefaultCamera>
                    <h:SunLight />
                    <h:GridLinesVisual3D Width="20" Length="20" MinorDistance="2" MajorDistance="2"
                                          Thickness="0.02" Fill="#2A5570" />
                    <ModelVisual3D Content="{Binding ShipModel}" />
                </h:HelixViewport3D>

                <!-- Actions on the finished ship, bottom-right of the viewport: the render and the
                     export both operate on what is on screen, so they sit with it rather than at
                     the end of a long parameter list. -->
                <!-- Raised clear of the bottom edge so it sits above the viewport's navigation cube
                     rather than on top of it. -->
                <Border Style="{StaticResource HudPanelStyle}" Padding="10,9"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,96">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="◉ RENDU STUDIO" Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnOpenStudio" Padding="12,8"
                                ToolTip="Ouvre une vue séparée avec occlusion ambiante et halo composité" />
                        <Button Content="EXPORTER .GLB" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ExportCommand}" FontSize="11.5" Padding="14,8" Margin="8,0,0,0"
                                ToolTip="Le fichier .glb s'importe directement dans Unity : glissez-le dans votre dossier Assets" />
                    </StackPanel>
                </Border>

                <!-- HUD: stats, bottom-left -->
                <Border Style="{StaticResource HudPanelStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="16" IsHitTestVisible="False">
                    <StackPanel MinWidth="170">
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="LONGUEUR" Style="{StaticResource HudLabelStyle}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Length, StringFormat='{}{0:0.0} M'}" Style="{StaticResource HudValueStyle}" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="MAÎTRE-BAU" Style="{StaticResource HudLabelStyle}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Beam, StringFormat='{}{0:0.0} M'}" Style="{StaticResource HudValueStyle}" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="CLASSE DE MASSE" Style="{StaticResource HudLabelStyle}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding MassClass}" Style="{StaticResource HudValueStyle}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource LineCyanDimBrush}" Margin="0,5" />
                        <Grid>
                            <TextBlock Text="TRIANGLES" Style="{StaticResource HudLabelStyle}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TriangleCount}" Style="{StaticResource HudValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- HUD: auto-rotate + reticle, top-right -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
                    <Border Style="{StaticResource HudPanelStyle}" Padding="10,7" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ORBITE AUTO" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <CheckBox x:Name="AutoRotateToggle" Style="{StaticResource ToggleSwitchStyle}" />
                        </StackPanel>
                    </Border>

                    <Grid Width="64" Height="64" Opacity="0.4" HorizontalAlignment="Right" IsHitTestVisible="False"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="ReticleRotation" Angle="0" />
                        </Grid.RenderTransform>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ReticleRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:50"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <Ellipse Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" StrokeDashArray="1 5" />
                        <Ellipse Width="46" Height="46" Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" />
                        <Line X1="32" Y1="0" X2="32" Y2="9" Stroke="{StaticResource AccentAmberBrush}" StrokeThickness="1.5" />
                        <Line X1="32" Y1="55" X2="32" Y2="64" Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" />
                        <Line X1="0" Y1="32" X2="9" Y2="32" Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" />
                        <Line X1="55" Y1="32" X2="64" Y2="32" Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1" />
                    </Grid>
                </StackPanel>

                <!-- Framing controls, top-centre. Until now the only way to recover a sane view was
                     to change a parameter and let the automatic re-frame fire, which is not a
                     control so much as a side effect — and it is deliberately suppressed while an
                     anchored panel is open. The six angles use the ship's own vocabulary rather
                     than the navigation cube's F/B/L/R/U/D, which say nothing about a hull. -->
                <Border Style="{StaticResource HudPanelStyle}" Padding="6,5"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="⛶ RECADRER" Style="{StaticResource ViewButtonStyle}" Margin="0"
                                Click="OnZoomExtents"
                                ToolTip="Cadre le vaisseau entier sans changer l'angle" />
                        <Button Content="✛ CENTRER" Style="{StaticResource ViewButtonStyle}"
                                Click="OnRecentre"
                                ToolTip="Ramène le vaisseau au centre de la vue sans changer la distance" />

                        <Border Width="1" Margin="7,2" Background="{StaticResource LineCyanDimBrush}" />

                        <Button Content="PROUE" Style="{StaticResource ViewButtonStyle}" Margin="0"
                                Click="OnViewBow" ToolTip="Vue de face, depuis l'avant" />
                        <Button Content="POUPE" Style="{StaticResource ViewButtonStyle}"
                                Click="OnViewStern" ToolTip="Vue de face, depuis l'arrière" />
                        <Button Content="BÂBORD" Style="{StaticResource ViewButtonStyle}"
                                Click="OnViewPort" ToolTip="Profil gauche" />
                        <Button Content="TRIBORD" Style="{StaticResource ViewButtonStyle}"
                                Click="OnViewStarboard" ToolTip="Profil droit" />
                        <Button Content="DESSUS" Style="{StaticResource ViewButtonStyle}"
                                Click="OnViewTop" ToolTip="Vue en plan, proue vers le haut" />
                        <Button Content="3/4" Style="{StaticResource ViewButtonStyle}"
                                Click="OnViewHero" ToolTip="Trois-quarts avant tribord, l'angle qui montre le plus de coque" />
                    </StackPanel>
                </Border>

                <!-- Settings anchored on the ship. Last child of the grid so it sits above the
                     viewport, and a Canvas rather than a Popup: a Popup's content lives under its
                     own PopupRoot, where the RelativeSource AncestorType=Window bindings this file
                     already uses would silently resolve to null.

                     Background is left unset rather than Transparent. A null background is not
                     hit-testable, so camera drags pass straight through the empty areas of the
                     overlay to the viewport underneath; Transparent would swallow every one of
                     them. ClipToBounds because a Grid does not clip, and a marker near the edge
                     would otherwise be drawn over the rail and the status bar. -->
                <Canvas x:Name="AnchorOverlay" ClipToBounds="True">
                    <!-- Drawn before the marker and the panel so it passes under both. Not
                         hit-testable: a stroked line does test along its own path, and this one
                         crosses the ship on its way to the panel. -->
                    <Polyline x:Name="LeaderLine" Visibility="Collapsed" IsHitTestVisible="False"
                              Stroke="{StaticResource LineCyanBrush}" StrokeThickness="1"
                              StrokeDashArray="3 3" Opacity="0.85" />

                    <ToggleButton x:Name="ShapePin"      Style="{StaticResource AnchorPinStyle}" Content="FORME"      Visibility="Collapsed" Checked="OnPinToggled" Unchecked="OnPinToggled" />
                    <ToggleButton x:Name="DimensionsPin" Style="{StaticResource AnchorPinStyle}" Content="DIMENSIONS" Visibility="Collapsed" Checked="OnPinToggled" Unchecked="OnPinToggled" />
                    <ToggleButton x:Name="WingPin"       Style="{StaticResource AnchorPinStyle}" Content="AILES"      Visibility="Collapsed" Checked="OnPinToggled" Unchecked="OnPinToggled" />
                    <ToggleButton x:Name="PropulsionPin" Style="{StaticResource AnchorPinStyle}" Content="PROPULSION" Visibility="Collapsed" Checked="OnPinToggled" Unchecked="OnPinToggled" />
                    <ToggleButton x:Name="CockpitPin"    Style="{StaticResource AnchorPinStyle}" Content="COCKPIT"    Visibility="Collapsed" Checked="OnPinToggled" Unchecked="OnPinToggled" />
                    <ToggleButton x:Name="TowerPin"      Style="{StaticResource AnchorPinStyle}" Content="TOURELLE"   Visibility="Collapsed" Checked="OnPinToggled" Unchecked="OnPinToggled" />
                    <ToggleButton x:Name="NacellePin"    Style="{StaticResource AnchorPinStyle}" Content="NACELLES"   Visibility="Collapsed" Checked="OnPinToggled" Unchecked="OnPinToggled" />
                    <ToggleButton x:Name="SurfacePin"    Style="{StaticResource AnchorPinStyle}" Content="SURFACE"    Visibility="Collapsed" Checked="OnPinToggled" Unchecked="OnPinToggled" />

                    <!-- Width is explicit and not negotiable: a Canvas measures its children against
                         infinite space, so without one nothing ever wraps and the panel grows until
                         it runs off the view. MaxHeight is set from code, against the overlay. -->
                    <Border x:Name="AnchorPanel" Visibility="Collapsed" Focusable="True" Width="258"
                            Background="{StaticResource BgPanelBrush}"
                            BorderBrush="{StaticResource LineCyanBrush}" BorderThickness="1"
                            CornerRadius="3">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4"
                                              Direction="270" Opacity="0.55" />
                        </Border.Effect>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="{StaticResource BgPanelAltBrush}">
                                <TextBlock x:Name="AnchorPanelTitle" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           FontWeight="Bold" Foreground="{StaticResource LineCyanBrush}" />
                                <Button Content="✕" Style="{StaticResource PanelCloseButtonStyle}"
                                        HorizontalAlignment="Right" Click="OnClosePanel"
                                        ToolTip="Fermer (Échap)" />
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10,12,12">
                                <!-- Content is the view model, never the active group: the eight
                                     templates are full of {Binding Length}-style bindings, and
                                     binding Content to an enum would make that enum their
                                     DataContext and break every one of them. The template itself is
                                     swapped from code, so only the open panel's subtree exists. -->
                                <ContentControl x:Name="AnchorPanelBody" Content="{Binding}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Canvas>
            </Grid>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource LineCyanDimBrush}" BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock Text="{Binding StatusText}" FontSize="10.5" TextWrapping="Wrap"
                       Foreground="{StaticResource TextDimBrush}" />
        </Border>
    </Grid>
</Window>
