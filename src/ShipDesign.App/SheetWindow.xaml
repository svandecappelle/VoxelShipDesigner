<Window x:Class="ShipDesign.App.SheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="ShipDesign — Planche" Height="960" Width="1240" MinHeight="760" MinWidth="1000"
        Background="#040A11"
        FontFamily="{StaticResource MonoFont}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource LineCyanDimBrush}" BorderThickness="0,0,0,1" Padding="18,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="PLANCHE" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                           Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="DesignationLabel" Margin="16,0,0,0" FontSize="11"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                <Button x:Name="SavePngButton" Content="⬇ ENREGISTRER PNG" Margin="28,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Click="OnSavePng"
                        ToolTip="Rend la planche au double de la résolution affichée, ce qui lisse le crénelage des arêtes" />
                <TextBlock x:Name="StatusLabel" Margin="18,0,0,0" FontSize="10.5"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Everything below is captured as one visual when saving, so the layout on screen and
             the layout in the exported file cannot diverge. -->
        <Grid x:Name="SheetRoot" Grid.Row="1" Background="#040A11">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="240" />
                <RowDefinition Height="260" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeroBackdrop" Grid.Row="0" ClipToBounds="True">
                <Grid.Background>
                    <RadialGradientBrush GradientOrigin="0.45,0.4" Center="0.45,0.4" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#142C3C" Offset="0" />
                        <GradientStop Color="#081521" Offset="0.6" />
                        <GradientStop Color="#03080E" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Background>

                <h:HelixViewport3D x:Name="HeroViewport" Background="Transparent"
                                   ShowCoordinateSystem="False" ShowViewCube="False" IsHeadLightEnabled="False" />
                <h:HelixViewport3D x:Name="HeroGlowViewport" Background="Transparent" IsHitTestVisible="False"
                                   ShowCoordinateSystem="False" ShowViewCube="False" IsHeadLightEnabled="False">
                    <h:HelixViewport3D.Effect>
                        <BlurEffect Radius="24" KernelType="Gaussian" />
                    </h:HelixViewport3D.Effect>
                </h:HelixViewport3D>
            </Grid>

            <Grid x:Name="Elevations" Grid.Row="1" Margin="18,10,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <h:HelixViewport3D x:Name="FrontViewport" Height="165" Background="Transparent"
                                       ShowCoordinateSystem="False" ShowViewCube="False" IsHeadLightEnabled="False" />
                    <TextBlock Text="AVANT" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10"
                               Foreground="{StaticResource TextDimBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <h:HelixViewport3D x:Name="SideViewport" Height="165" Background="Transparent"
                                       ShowCoordinateSystem="False" ShowViewCube="False" IsHeadLightEnabled="False" />
                    <TextBlock Text="PROFIL" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10"
                               Foreground="{StaticResource TextDimBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <h:HelixViewport3D x:Name="TopViewport" Height="165" Background="Transparent"
                                       ShowCoordinateSystem="False" ShowViewCube="False" IsHeadLightEnabled="False" />
                    <TextBlock Text="DESSUS" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10"
                               Foreground="{StaticResource TextDimBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <h:HelixViewport3D x:Name="BackViewport" Height="165" Background="Transparent"
                                       ShowCoordinateSystem="False" ShowViewCube="False" IsHeadLightEnabled="False" />
                    <TextBlock Text="ARRIÈRE" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10"
                               Foreground="{StaticResource TextDimBrush}" />
                </StackPanel>

                <!-- Compact on purpose: this panel sits in a fixed-height band, and a taller block
                     overflows it and loses its own last line off the bottom of the exported image. -->
                <Border Grid.Column="4" Style="{StaticResource HudPanelStyle}" Padding="13,10"
                        VerticalAlignment="Bottom" MaxHeight="200" Width="268">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="PALETTE" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource LineCyanBrush}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="DimensionsLabel" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <ItemsControl x:Name="PaletteStrip" Width="242">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="26" Height="19" Margin="0,0,4,4" CornerRadius="2"
                                            BorderBrush="#40FFFFFF" BorderThickness="1"
                                            Background="{Binding Brush}" ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="DIMENSIONS EN VOXELS" FontSize="9" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
