<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ShipDesign.App.Converters">

    <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    <conv:EnumLabelConverter x:Key="EnumLabelConverter" />
    <conv:HullShapeIconConverter x:Key="HullShapeIconConverter" />
    <conv:HullArrangementIconConverter x:Key="HullArrangementIconConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Palette, matching vessel-forge.html -->
    <SolidColorBrush x:Key="BgDeepBrush" Color="#081826" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="#0C2338" />
    <SolidColorBrush x:Key="BgPanelAltBrush" Color="#0F2C45" />
    <SolidColorBrush x:Key="LineCyanBrush" Color="#7FD4E8" />
    <SolidColorBrush x:Key="LineCyanDimBrush" Color="#387FD4E8" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#DCEFF5" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#7C97A6" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="#F2A65C" />
    <SolidColorBrush x:Key="AccentAmberDimBrush" Color="#29F2A65C" />
    <SolidColorBrush x:Key="HudBackdropBrush" Color="#B8081826" />

    <FontFamily x:Key="MonoFont">Cascadia Mono</FontFamily>
    <FontFamily x:Key="DisplayFont">Bahnschrift SemiBold</FontFamily>

    <!-- ============ Text styles ============ -->

    <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource LineCyanBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

    <Style x:Key="FieldValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="HudLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="Margin" Value="0,0,24,0" />
    </Style>

    <Style x:Key="HudValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ============ Panel border ============ -->

    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgPanelAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineCyanDimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="HudPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HudBackdropBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineCyanDimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="15,11" />
    </Style>

    <!-- ============ Accordion ============ -->

    <!-- Collapsible version of PanelBorderStyle. The sidebar carries far more parameters than fit
         on screen at once, and scrolling past sections you are not editing to reach one you are is
         the actual cost; folding them away is what makes the panel navigable. -->
    <Style x:Key="AccordionStyle" TargetType="Expander">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{StaticResource BgPanelAltBrush}"
                            BorderBrush="{StaticResource LineCyanDimBrush}"
                            BorderThickness="1" CornerRadius="2">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderButton" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBd" Background="Transparent" Padding="14,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center"
                                                           Fill="{StaticResource AccentAmberBrush}" Margin="0,0,7,0" />
                                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}"
                                                           Style="{StaticResource PanelTitleStyle}" Margin="0" VerticalAlignment="Center" />
                                                <!-- Rotated rather than swapped for a different glyph, so the
                                                     marker keeps the same weight in both states. -->
                                                <TextBlock x:Name="Chevron" Grid.Column="2" Text="⌃" FontSize="12"
                                                           Foreground="{StaticResource LineCyanBrush}" VerticalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBd" Property="Background" Value="{StaticResource BgPanelBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="ContentBd" Padding="14,0,14,12">
                                <ContentPresenter />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ContentBd" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Buttons ============ -->

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource LineCyanBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineCyanDimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineCyanBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentAmberBrush}" />
        <Setter Property="Foreground" Value="#0B1B2B" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,13" />
    </Style>

    <!-- Segmented "button-group" look for the ship template picker -->
    <Style x:Key="SegmentedItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource LineCyanDimBrush}"
                            BorderThickness="1" CornerRadius="2" Margin="0,0,6,6" Padding="10,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentAmberDimBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineCyanBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentedListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentedItemStyle}" />
        <!-- Without this, ListBox's built-in ScrollViewer defaults to horizontal scrolling
             and the WrapPanel below never actually gets to wrap within the available width. -->
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ TextBox ============ -->

    <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgDeepBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineCyanDimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentAmberBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ============ Slider ============ -->

    <Style x:Key="SliderRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" Height="20" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="2" Background="{StaticResource LineCyanDimBrush}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeatButtonStyle}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeatButtonStyle}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Width="12" Height="12" Fill="{StaticResource AccentAmberBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Color swatch buttons (livery) ============ -->

    <Style x:Key="SwatchButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{Binding Converter={StaticResource ColorToBrushConverter}}"
                            BorderBrush="{StaticResource LineCyanDimBrush}" BorderThickness="1" CornerRadius="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineCyanBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Toggle switch (auto-rotate) ============ -->

    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <!-- The template paints fixed colours, so a disabled switch looked exactly like an enabled
             one. It has a disabled state now: the orbit is suspended while an anchored panel is
             open, and a control that does nothing has to look like it. -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="32" Height="17" CornerRadius="9"
                            Background="{StaticResource BgDeepBrush}" BorderBrush="{StaticResource LineCyanDimBrush}" BorderThickness="1">
                        <Ellipse x:Name="Thumb" Width="11" Height="11" Fill="{StaticResource TextDimBrush}"
                                 HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentAmberDimBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource AccentAmberBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A die, drawn rather than typed. U+2684 renders as a missing-glyph box in Cascadia Mono,
         which is the font every button here uses, so the character route gives a tofu square and
         not an icon. One geometry with the pips as holes: the default even-odd fill rule punches
         them out of the face, so a single Path in the accent colour is the whole icon. Square pips
         rather than round ones stay crisp at 12px and suit a voxel tool. -->
    <PathGeometry x:Key="DieIcon"
                  Figures="M0,0 H12 V12 H0 Z M2,2 h2 v2 h-2 Z M8,2 h2 v2 h-2 Z M5,5 h2 v2 h-2 Z M2,8 h2 v2 h-2 Z M8,8 h2 v2 h-2 Z" />

    <!-- ============ Silhouette groups ============ -->

    <!-- A second, lighter level of folding *inside* the silhouettes section, one fold per universe.
         Deliberately not AccordionStyle: nesting that style inside itself gives two bordered boxes
         with two chevrons and two title weights, and the sidebar stops reading as a hierarchy at
         all. This one has no border and a smaller header, so it reads as a subdivision of the
         section rather than as a section of its own. -->
    <Style x:Key="SilhouetteGroupStyle" TargetType="Expander">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Cursor="Hand" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent" Padding="2,6,2,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Universe}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentAmberBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="Chevron" Grid.Column="1" Text="⌃" FontSize="10"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource AccentAmberBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Anchored settings ============ -->

    <!-- A marker sitting on the part of the ship its settings control. Deliberately a bare dot with
         the label only on hover: eight of these are on screen at once, over the ship itself, and
         eight permanent labels would be a second sidebar drawn on top of the model.

         Two details the template cannot do without. The root needs a Background, or only the 11px
         dot is clickable rather than the whole 30px square — a null background is not hit-testable.
         And the label sits in a Canvas so that revealing it does not change the button's layout
         size: the dot is centred on the anchor, and a label that grew the button would shove the
         dot off the very thing it is pointing at, on hover, every time. -->
    <Style x:Key="AnchorPinStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Halo" Width="26" Height="26" Opacity="0"
                                 Fill="{StaticResource AccentAmberDimBrush}" />
                        <Ellipse x:Name="Dot" Width="11" Height="11"
                                 Fill="{StaticResource AccentAmberBrush}"
                                 Stroke="{StaticResource BgDeepBrush}" StrokeThickness="2" />
                        <Canvas>
                            <Border x:Name="Label" Canvas.Left="21" Canvas.Top="4" Visibility="Collapsed"
                                    Background="{StaticResource HudBackdropBrush}"
                                    BorderBrush="{StaticResource AccentAmberBrush}" BorderThickness="1"
                                    CornerRadius="2" Padding="6,2">
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentAmberBrush}" />
                            </Border>
                        </Canvas>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- The open marker keeps its label, so the panel and the point it belongs
                             to stay tied together once the pointer has moved into the panel. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource LineCyanBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact enough that eight of them fit across the top of the viewport without becoming a
         second toolbar. Same visual language as SecondaryButtonStyle, just tighter. -->
    <Style x:Key="ViewButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="2,0,0,0" />
    </Style>

    <Style x:Key="PanelCloseButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" Width="24" Height="22" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentAmberDimBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
